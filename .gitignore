# Dependencies
node_modules/

# Local overrides and secrets – never commit
# (.env and .env.[mode] hold public build config and are committed, see Vite docs "Env Variables and Modes")
.env.local
.env.*.local

# Build output
dist/
build/

# Personal notes (not part of the repo)
*.local.md

# Logs
*.log
npm-debug.log*

# Local certificates for HTTPS testing
*.pem
*.key
*.crt

# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
