{
  "name": "apiracer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mehrspieler-Rennspiel: Handys steuern per WebRTC DataChannel ein Spiel im PC-Browser",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/server.ts\" \"vite\"",
    "dev:https": "concurrently -k -n server,web -c blue,green \"tsx watch server/server.ts\" \"vite --mode https\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
